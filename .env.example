# Copia este archivo como .env y completa los valores (Supabase > Project Settings > API).

# Públicos (el prefijo NEXT_PUBLIC_ los expone al navegador)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA: solo en el servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# SECRETA: llave de la API de Claude (análisis de uso del teléfono con IA). Solo en el servidor.
ANTHROPIC_API_KEY=

# Opcional: YouTube Data API v3 (console.cloud.google.com > APIs y servicios). Sin ella la IA no recomienda videos.
# SECRETA: solo en el servidor.
YOUTUBE_API_KEY=
